generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String   @default("CUSTOMER")
  firstName String
  lastName  String
  phone     String?
  country   String?
  birthday  DateTime?
  marketingOptIn Boolean @default(false)
  termsAccepted  Boolean @default(false)
  agreementVersion String?
  agreementTimestamp DateTime?
  
  avatarUrl      String?
  status         String   @default("ACTIVE")
  
  twoFactorSecret      String?
  isTwoFactorEnabled   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendorProfile VendorProfile?
  riderProfile  RiderProfile?
  parentOrders  ParentOrder[]
  orders        Order[]
  wishlists     WishlistItem[]
  reviews       Review[]
  addresses     CustomerAddress[]
}

model ParentOrder {
  id             String   @id @default(uuid())
  
  customerId     String?
  customer       User?    @relation(fields: [customerId], references: [id])
  
  guestEmail     String?
  guestName      String?
  guestPhone     String?
  deliveryInstructions String?

  totalAmount    Float
  reference      String   @unique
  status         String   @default("PENDING") // PENDING, SUCCESS, FAILED
  
  orders         Order[]
  payment        Payment?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model VendorProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  
  storeName   String
  description String?
  logoUrl     String?
  logoPublicId  String?
  coverUrl    String?
  coverPublicId String?
  address     String?
  coordinates String? // JSON string
  
  businessType String // Food, Fashion, Retail, Agriculture, etc.
  isRegistered Boolean @default(false)
  status      String  @default("PENDING")
  openingHours String?
  
  paystackSubaccount String?

  subcategories Subcategory[]
  products    Product[]
  orders      Order[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Subcategory {
  id          String   @id @default(uuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  
  name        String
  slug        String   @unique
  image       String?
  
  vendors     VendorProfile[]
  products    Product[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RiderProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  
  address      String?
  city         String?
  
  vehicleType  String
  plateNumber  String?
  
  idType             String?
  idNumber           String?
  idDocumentUrl      String?
  profilePhotoUrl    String?
  licenseDocumentUrl String?
  
  isOnline     Boolean  @default(false)
  currentLocation String? // JSON string
  
  status       String   @default("PENDING")
  deliveries   Order[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  image       String?
  products    Product[]
  subcategories Subcategory[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  vendorId    String
  vendor      VendorProfile @relation(fields: [vendorId], references: [id])
  
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])
  
  name        String
  description String
  price       Float
  discount    Float    @default(0)
  inventory   Int      @default(0)
  isAvailable Boolean  @default(true)
  unit        String?
  images      String   // Cloudinary secure_url
  imagePublicId String?  // Cloudinary public_id for deletion
  sku         String?
  variations  String?  // JSON string

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]
  wishlists   WishlistItem[]
  reviews     Review[]
}

model Order {
  id             String   @id @default(uuid())
  
  parentOrderId  String
  parentOrder    ParentOrder @relation(fields: [parentOrderId], references: [id])

  customerId     String?
  customer       User?     @relation(fields: [customerId], references: [id])
  
  vendorId       String
  vendor         VendorProfile @relation(fields: [vendorId], references: [id])
  
  riderId        String?
  rider          RiderProfile? @relation(fields: [riderId], references: [id])
  
  subtotal       Float
  deliveryFee    Float
  platformFee    Float
  vendorEarnings Float    @default(0)
  riderEarnings  Float    @default(0)
  total          Float
  
  status         String   @default("PENDING_PAYMENT") 
  type           String   // DELIVERY, PICKUP
  
  deliveryAddress String? // JSON string

  items          OrderItem[]
  payment        Payment?  // Retaining for direct vendor payouts compatibility

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  
  quantity  Int
  price     Float
  options   String?  // JSON string

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id            String   @id @default(uuid())
  
  orderId       String?  @unique
  order         Order?   @relation(fields: [orderId], references: [id])
  
  parentOrderId String?  @unique
  parentOrder   ParentOrder? @relation(fields: [parentOrderId], references: [id])
  
  amount        Float
  reference     String   @unique // Paystack Reference
  status        String   @default("PENDING") // PENDING, SUCCESS, FAILED
  splitDetails  String?    // JSON string

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  rating    Int
  comment   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enquiry {
  id        String   @id @default(uuid())
  email     String
  subject   String
  message   String
  status    String   @default("OPEN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerAddress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  label     String   @default("Home") // Home, Work, Other
  line1     String
  line2     String?
  city      String
  state     String?
  country   String   @default("Nigeria")
  isDefault Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
